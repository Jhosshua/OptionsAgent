ALPACA_PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DISCORD_WEBHOOK_URL=

# Trading stays disarmed until the new paper deployment is independently verified.
OA_TRADING_ENABLED=false
OA_DASHBOARD_HOST=127.0.0.1

# Local Claude Code CLI proposal analyst. The CLI uses the operator's existing
# Claude Code login; no ANTHROPIC_API_KEY is needed.
OA_CLAUDE_CLI=claude
OA_CLAUDE_MODEL=sonnet
OA_CLAUDE_TIMEOUT_SECONDS=180

# Optional read-only Public.com market-data sidecar. Alpaca remains execution-only.
# Set OA_OPTIONS_DATA_PROVIDER=public only after validating these credentials.
OA_OPTIONS_DATA_PROVIDER=alpaca
PUBLIC_API_SECRET=
PUBLIC_ACCOUNT_ID=
PUBLIC_OPTIONS_DTE_MIN=30
PUBLIC_OPTIONS_DTE_MAX=45
PUBLIC_QUOTE_BATCH_SIZE=50
PUBLIC_API_TIMEOUT_SECONDS=10
