ALPACA_PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DISCORD_WEBHOOK_URL=

# Trading stays disarmed until the new paper deployment is independently verified.
OA_TRADING_ENABLED=false
OA_DASHBOARD_HOST=127.0.0.1

# AI proposal analyst (harness/proposer.py): the Antigravity CLI (agy) with Gemini.
# Login is the ~/.gemini folder (Railway: GEMINI_HOME_TGZ_B64, restored by entrypoint.sh).
# Only gemini-3.8-flash-low and gemini-3.8-flash-medium are accepted.
OA_AGY_MODEL=gemini-3.8-flash-low
# On the Mac point at the raw binary, not the ~/.local/bin/agy wrapper (it adds
# --dangerously-skip-permissions). On Railway `agy` is on PATH.
# OA_AGY_CLI=/Users/mo/.local/bin/agy-bin
OA_LLM_TIMEOUT_SECONDS=240
OA_LLM_ATTEMPTS=3

# Optional read-only Public.com market-data sidecar. Alpaca remains execution-only.
# Set OA_OPTIONS_DATA_PROVIDER=public only after validating these credentials.
OA_OPTIONS_DATA_PROVIDER=alpaca
PUBLIC_API_SECRET=
PUBLIC_ACCOUNT_ID=
PUBLIC_OPTIONS_DTE_MIN=30
PUBLIC_OPTIONS_DTE_MAX=45
PUBLIC_QUOTE_BATCH_SIZE=50
PUBLIC_API_TIMEOUT_SECONDS=10

# Dashboard button destination for Discord Components V2 cards.
OA_DASHBOARD_URL=https://optionsagent-production.up.railway.app
